Project academia_idiomas {
  database_type: "MySQL"
  Note: "Esquema base para gestión de academia de idiomas en WordPress"
}

Table "idiomas" {
  "id" tinyint(3) [pk, increment, not null]
  "nombre" varchar(50) [unique, not null]
  "activo" boolean [not null, default: true]
  "created_at" datetime
  "updated_at" datetime
}
Table "idiomas_profesores" {
  "idioma_id" tinyint [not null, ref: > "idiomas"."id"]
  "profesor_id" int [not null, ref: > "profesores"."id"]

  indexes {
    ("idioma_id", "profesor_id") [pk]
    "profesor_id"
  }
}
Table "niveles" {
  "id" tinyint [pk, increment]
  "nombre" varchar(20) [not null, unique]
  "orden" tinyint [not null, note: "Orden de visualización de los niveles, por ejemplo: A1=1, A2=2, B1=3, B2=4"]
  "activo" boolean [not null, default: true]
  "created_at" datetime
  "updated_at" datetime
}

Table "aulas" {
  "id" smallint [pk, increment]
  "nombre" varchar(50) [not null, unique]
  "capacidad" tinyint [not null, note: "Capacidad física del aula: número máximo de personas que soporta"]
  "activo" boolean [not null, default: true]
  "created_at" datetime
  "updated_at" datetime
}

Table "cursos_escolares" {
  Note: '''
  Restricciones lógicas:
  - Solo debería existir un curso escolar activo a la vez.
  - Esta validación debe controlarse desde la aplicación o lógica SQL adicional.
  '''

  "id" smallint [pk, increment]
  "nombre" varchar(20) [not null, unique]
  "fecha_inicio" date [not null]
  "fecha_fin" date [not null]
  "activo" boolean [not null, default: false]
  "created_at" datetime
  "updated_at" datetime
   
}

Table "profesores" {
  "id" int [pk, increment]
  "wp_user_id" int [unique, note: "Opcional, si el profesor también es usuario de WordPress"]
  "nombre" varchar(80) [not null]
  "apellidos" varchar(120) [not null]
  "email" varchar(120) [unique, not null]
  "telefono" varchar(30)
  "activo" boolean [not null, default: true]
  "created_at" datetime
  "updated_at" datetime
}

Table "grupos" {
  Note: '''
  Restricciones lógicas:
  - No debe haber grupos duplicados funcionalmente para la misma combinación de curso, idioma, nivel y aula.
  - plazas_ofertadas debe ser menor o igual que aulas.capacidad.
  - plazas_ocupadas no debe ser mayor que plazas_ofertadas.
  - Las plazas disponibles se calculan en la aplicación como:
    plazas_ofertadas - plazas_ocupadas.
  '''

  "id" int [pk, increment]
  "curso_id" smallint [not null, ref: > "cursos_escolares"."id"]
  "idioma_id" tinyint [not null, ref: > "idiomas"."id"]
  "nivel_id" tinyint [not null, ref: > "niveles"."id"]
  "aula_id" smallint [not null, ref: > "aulas"."id"]
  "profesor_id" int [not null, ref: > "profesores"."id"]
  "plazas_ofertadas" tinyint [not null, note: "Plazas que se ofertan para este grupo; debe ser menor o igual que aulas.capacidad"]
  "plazas_ocupadas" tinyint [not null, default: 0, note: "Número de plazas ya ocupadas por matrículas"]
  "activo" boolean [not null, default: true]
  "observaciones" varchar(255) [note: "Notas internas del grupo: incidencias, aclaraciones organizativas o particularidades no modeladas en otros campos"]
  "created_at" datetime
  "updated_at" datetime

  indexes {
    "curso_id"
    "idioma_id"
    "nivel_id"
    "aula_id"
    "profesor_id"
    ("curso_id", "idioma_id", "nivel_id", "aula_id")
  }
}

Table "grupo_horarios" {
  Note: '''
  Restricciones lógicas:
  - hora_fin debe ser mayor que hora_inicio.
  - No debe haber solapes de aula entre grupos activos en la misma franja horaria.
  - No debe haber solapes de profesor entre grupos activos en la misma franja horaria.
  - Estas validaciones deben controlarse desde la aplicación o con SQL específico.
  '''

  "id" int [pk, increment]
  "grupo_id" int [not null, ref: > "grupos"."id"]
  "dia_semana" tinyint [not null, note: "1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado, 7=Domingo"]
  "activo" boolean [not null, default: true]
  "hora_inicio" time [not null]
  "hora_fin" time [not null]
  "created_at" datetime
  "updated_at" datetime

  indexes {
    "grupo_id"
    ("dia_semana", "hora_inicio", "hora_fin")
    ("grupo_id", "dia_semana", "hora_inicio") [unique]
  }
}
